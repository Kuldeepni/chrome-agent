# chrome-agent configuration
# Copy this file to `.env` and adjust as needed.

# CDP endpoint of the running Chrome instance.
# Chrome must be started with --remote-debugging-port=9222 for this to work.
CHROME_CDP_URL=http://localhost:9222

# Allow the run_javascript tool to execute arbitrary JS in the page.
# Disabled by default. Set to true only if you trust the agent's prompts.
ALLOW_JS=false

# Directory that upload_file() is allowed to read files from.
# Any file outside this directory is rejected.
# Default when unset: your home Downloads folder.
ALLOWED_UPLOAD_DIR=~/Downloads

# Where downloaded files are saved.
# Default when unset: ./downloads (relative to the project folder).
DOWNLOAD_DIR=./downloads

# Where the audit log is written.
# Default when unset: ./logs (relative to the project folder).
LOG_DIR=./logs

# Default timeout in milliseconds for element actions.
DEFAULT_TIMEOUT_MS=15000

# How long to wait for a JavaScript dialog before dismissing it.
DIALOG_TIMEOUT_MS=8000

# Follow the user's active tab automatically.
FOLLOW_ACTIVE_TAB=true

# Profile directory used by the Chrome launch command in the README.
CHROME_PROFILE_DIR=./chrome-profile
